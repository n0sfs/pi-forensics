[Unit]
Description=ARM Forensic Acquisition Station (gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/pi-forensics
Environment="FORENSIC_USER=admin"
Environment="FORENSIC_PASS=CHANGE_ME"
Environment="FORENSIC_AUTH_BYPASS=0"
ExecStart=/opt/pi-forensics/venv/bin/python3 -m gunicorn --workers 2 --timeout 300 --bind 127.0.0.1:5000 app:app
Restart=always
RestartSec=3
PrivateTmp=true

[Install]
WantedBy=multi-user.target
